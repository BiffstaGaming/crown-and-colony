<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CrownAndColony.GameLogic</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- App version (the player-facing release number; surfaced via AppInfo.Version, shown on the About screen).
         This is the application/release version — NOT the save-format version in SaveGame.cs. FreeCol equivalent:
         FreeCol.FREECOL_VERSION / getVersion(). -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
  </PropertyGroup>

  <!-- This library must remain engine-free (ADR-006): no Godot package references, ever. -->

  <ItemGroup>
    <InternalsVisibleTo Include="GameLogic.Tests" />
  </ItemGroup>

  <!-- The classic ruleset ships inside the assembly so game, tests, and CI all
       read identical bytes and Godot exports need no loose-file handling. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\rules\classic\specification.xml"
                      LogicalName="CrownAndColony.GameLogic.Specification.classic.specification.xml" />
    <!-- Per-nation colony names (not in the spec XML — extracted from FreeCol's message strings; FP-3a). -->
    <EmbeddedResource Include="..\..\data\rules\classic\european-nation-names.properties"
                      LogicalName="CrownAndColony.GameLogic.Specification.classic.european-nation-names.properties" />
    <!-- Fixed scenario maps — FreeCol's hand-made America map (terrain grid, extracted from M_America_Mazim.fsm; GPL v2). -->
    <EmbeddedResource Include="..\..\data\maps\america.txt"
                      LogicalName="CrownAndColony.GameLogic.Maps.america.txt" />
    <!-- A tiny example scenario exercising every MapImporter overlay (resources/improvements/rumours/settlements). -->
    <EmbeddedResource Include="..\..\data\maps\example-overlays.txt"
                      LogicalName="CrownAndColony.GameLogic.Maps.example-overlays.txt" />
  </ItemGroup>

</Project>
