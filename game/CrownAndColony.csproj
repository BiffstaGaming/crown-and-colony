<Project Sdk="Godot.NET.Sdk/4.6.3">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>CrownAndColony</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src\GameLogic\GameLogic.csproj" />
  </ItemGroup>

  <!-- src/ and tests/ are separate projects; keep them out of this project's
       default **/*.cs compile glob. -->
  <ItemGroup>
    <Compile Remove="src\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <!-- Presentation layer only (ADR-006): scenes/scripts here may use Godot;
       all game rules belong in src/GameLogic. -->

</Project>
