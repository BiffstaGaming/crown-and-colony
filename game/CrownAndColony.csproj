<Project Sdk="Godot.NET.Sdk/4.6.3">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Lets the VSTest host (L3 tests) run on a newer installed runtime. -->
    <RollForward>LatestMajor</RollForward>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>CrownAndColony</RootNamespace>
    <!-- App/release version (kept in lockstep with GameLogic.csproj; AppInfo.Version reads the GameLogic assembly's
         informational version, so this is for the Godot assembly's own metadata). Not the save-format version. -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
  </PropertyGroup>

  <!-- L3 interaction tests (presentation/tests) live inside this project: the
       GdUnit4 adapter requires the test assembly's project to BE the Godot
       project (official gdUnit4Net example layout). Run with:
       dotnet test CrownAndColony.csproj (settings file: gdunit.runsettings) -->
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <VSTestTestAdapterPath>none</VSTestTestAdapterPath>
    <TestFramework>GdUnit4</TestFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="gdUnit4.api" Version="5.0.0" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\GameLogic\GameLogic.csproj" />
  </ItemGroup>

  <!-- src/ and tests/ are separate projects; keep them out of this project's
       default **/*.cs compile glob. -->
  <ItemGroup>
    <Compile Remove="src\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <!-- Presentation layer only (ADR-006): scenes/scripts here may use Godot;
       all game rules belong in src/GameLogic. -->

</Project>
